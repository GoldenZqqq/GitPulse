{
  "name": "gitpulse",
  "private": true,
  "version": "0.7.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:e2e:responsive": "playwright test tests/e2e/responsive-hardening.spec.ts",
    "test:release-governance": "node --test tests/scripts/release-governance.test.mjs",
    "tauri": "tauri",
    "build:tauri:smoke": "node ./scripts/build-tauri-smoke.mjs",
    "test:tauri-smoke": "node ./scripts/tauri-smoke.mjs",
    "tauri:build:release": "tauri build --config src-tauri/tauri.release.conf.json",
    "version:patch": "node ./scripts/bump-version.mjs patch",
    "version:minor": "node ./scripts/bump-version.mjs minor",
    "version:major": "node ./scripts/bump-version.mjs major",
    "version:set": "node ./scripts/set-version.mjs",
    "build:patch": "node ./scripts/bump-version.mjs patch && npm run tauri:build:release",
    "build:minor": "node ./scripts/bump-version.mjs minor && npm run tauri:build:release",
    "build:major": "node ./scripts/bump-version.mjs major && npm run tauri:build:release",
    "verify:release": "node ./scripts/verify-release.mjs",
    "release:check": "node ./scripts/verify-release.mjs",
    "release:notes": "node ./scripts/generate-release-notes.mjs patch",
    "release:notes:patch": "node ./scripts/generate-release-notes.mjs patch",
    "release:notes:minor": "node ./scripts/generate-release-notes.mjs minor",
    "release:notes:major": "node ./scripts/generate-release-notes.mjs major",
    "release:notes:set": "node ./scripts/generate-release-notes.mjs --set",
    "release:notes:current": "node ./scripts/generate-release-notes.mjs current",
    "release:win": "node ./scripts/publish-release.mjs patch",
    "release:win:patch": "node ./scripts/publish-release.mjs patch",
    "release:win:minor": "node ./scripts/publish-release.mjs minor",
    "release:win:major": "node ./scripts/publish-release.mjs major",
    "release:win:set": "node ./scripts/publish-release.mjs --set",
    "release:win:current": "node ./scripts/publish-release.mjs current"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.21",
    "@radix-ui/react-slot": "^1.3.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
